# ────────────────────────────────────────────────────────────────────────────
# Application
# ────────────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8080

# ────────────────────────────────────────────────────────────────────────────
# Auth (highly recommended for non-local access)
# ────────────────────────────────────────────────────────────────────────────
# Enable HTTP Basic Authentication. Set to true if exposing the web interface beyond localhost.
# WARNING: Do not expose the app directly to the public internet without enabling auth.
AUTH_ENABLED=false
# If auth is enabled, set a strong username and password below:
# AUTH_USERNAME=admin
# AUTH_PASSWORD=make-sure-to-use-a-strong-password-here

# ────────────────────────────────────────────────────────────────────────────
# Browser extension API (optional)
# ────────────────────────────────────────────────────────────────────────────
# Enables /api/extension/status and /api/extension/queue.
# If false, those endpoints return 404 by design.
EXTENSION_API_ENABLED=false
# Required when EXTENSION_API_ENABLED=true (app refuses to start without it).
# Generate with: openssl rand -hex 32
# EXTENSION_API_TOKEN=generate-a-random-token-here

# ────────────────────────────────────────────────────────────────────────────
# Infrastructure
# ────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
DATABASE_URL=sqlite+aiosqlite:////data/app.db

# ────────────────────────────────────────────────────────────────────────────
# Paths & Placeholders Mapping
# ────────────────────────────────────────────────────────────────────────────
# Note: For Proxmox/Native VM installs, the following user placeholders map to these variables:
#   - AUDIOBOOKSHELF_IMPORT_DIR  => OUTPUT_ROOT (Destination directory ABS scans)
#   - DOWNLOAD_DIR               => WORK_DIR (Where videos are downloaded/converted)
#   - TEMP_DIR                   => WORK_DIR (Temporary workspace)
#   - METADATA_DIR               => ARCHIVE_FILE directory or SQLite database directory
#   - COOKIES_FILE               => Map using YTDLP_EXTRA_ARGS=--cookies /path/to/cookies.txt
#   - UID/GID                    => Configure PUID/PGID to match NFS/local owner permissions (Docker mode)

WORK_DIR=/data/work
ARCHIVE_FILE=/data/config/youtube-archive.txt

# Host directory that Audiobookshelf scans.
# Mac example:
# HOST_PODCASTS_DIR=/Volumes/Synology/Media/Podcasts
# Proxmox/Linux example:
# HOST_PODCASTS_DIR=/mnt/podcasts
HOST_PODCASTS_DIR=/mnt/podcasts

# Path inside the reeldock containers.
# Usually do not change this.
CONTAINER_PODCASTS_DIR=/media/podcasts

# App output root. In Docker this should normally match CONTAINER_PODCASTS_DIR.
#
# IMPORTANT: In Docker, the application sees the container path, NOT the host path.
# The Settings page in the web UI should normally use /media/podcasts in Docker.
# Do NOT use host paths like /Volumes/... or /mnt/... as OUTPUT_ROOT inside Docker
# unless that exact path is mounted into the container.
OUTPUT_ROOT=/media/podcasts

# ────────────────────────────────────────────────────────────────────────────
# Download behaviour
# ────────────────────────────────────────────────────────────────────────────
# Accept playlist URLs and enumerate videos for batch selection in the UI.
ALLOW_PLAYLISTS=false
# Accept channel URLs and enumerate videos for batch selection in the UI.
ALLOW_CHANNELS=false
# Cap how many videos are listed/queued from one playlist or channel.
MAX_PLAYLIST_ENTRIES=100
# DEFAULT_DESTINATION_FOLDER=

# Skip sponsor segments via yt-dlp SponsorBlock (global default; overridable per job).
SPONSORBLOCK_REMOVE=false

# Optional loudness normalization (EBU R128) during ffmpeg conversion.
LOUDNESS_NORMALIZE=false
LOUDNESS_TARGET_LUFS=-16
LOUDNESS_AUDIO_BITRATE=192k

YTDLP_BIN=yt-dlp
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
YTDLP_AUDIO_FORMAT=m4a
YTDLP_AUDIO_QUALITY=
# YTDLP_EXTRA_ARGS=
# FFMPEG_EXTRA_ARGS=

OUTPUT_EXTENSION=m4b
FILENAME_TEMPLATE={title}.m4b

# ────────────────────────────────────────────────────────────────────────────
# Job management
# ────────────────────────────────────────────────────────────────────────────
JOB_TIMEOUT_SECONDS=10800
RETRY_MAX=3
RETRY_INTERVAL_SECONDS=60,300,900
CLEANUP_TEMP_ON_SUCCESS=true
CLEANUP_TEMP_ON_FAILURE=false
COLLISION_MODE=append_id   # skip | overwrite | append_id | append_counter

# ────────────────────────────────────────────────────────────────────────────
# Audiobookshelf (optional)
# ────────────────────────────────────────────────────────────────────────────
# ABS_BASE_URL=http://audiobookshelf:13378
# ABS_API_TOKEN=your-abs-api-token
# ABS_LIBRARY_ID=your-library-id
ABS_SCAN_AFTER_SUCCESS=false

# ────────────────────────────────────────────────────────────────────────────
# Development
# ────────────────────────────────────────────────────────────────────────────
DRY_RUN=false
